

section.apartaments#apartaments
	.container 
		.apartaments__title 
			+title('планировки', 'апартаментов')
		.previews.apartaments__previews 
			+preview('apartaments-0.webp', 'Презентабельный вид начиная с холла', 'preview--sm', 'preview--grid2')
			+preview('apartaments-1.webp', 'Вариант отделки', 'preview--sm', 'preview--grid2')
			+preview('apartaments-2.webp', 'Вариант отделки', 'preview--sm', 'preview--grid2')
			+preview('apartaments-3.webp', 'Планировка', 'preview--lg', 'preview--grid2')
			.preview.preview--lg.preview--grid2
				.preview-central
					.preview-central__text высота потолков #[br] от #[span 3,5 м]
					img.preview-central__img(src="img/boy.webp", alt="boy")
			+preview('apartaments-4.webp', 'Вариант отделки', 'preview--md', 'preview--grid1')
			+preview('apartaments-5.webp', 'Общая комната для досуга, детская комната', 'preview--sm', 'preview--grid2')


