-
	locationItem = [
		{
			title: 'Транспортная доступность', 
			list: [
				{icon: 'icon-car.png', text: 'До МКАД 30 минут'},
				{icon: 'icon-metro.png', text: 'Станция "Соколовская" - 20 минут '},
				{icon: 'icon-metro.png', text: 'Станция "Воронок" - 18 минут '}
			]
		},
		{
			title: 'В шаговой доступности', 
			list: [
				{icon: 'icon-shop.png', text: 'Сетевые продуктовые магазины'},
				{icon: 'icon-cinema.png', text: 'Кинотеатр "5 звезд" '},
				{icon: 'icon-school.png', text: 'Школы, детские сады '}
			]
		}
	]

section.location#location 
	.container 
		.location__title
			+title('удобное', 'расположение')
		.location__box
			img.location__logo(src="img/logo.png", alt="logo")
			.location__items 
				each item in locationItem 
					.location__name= item.title
					ul.location__list 
						each li in item.list 
							li.location__item 
								img.location__icon(src="img/icons/" + li.icon, alt="")
								span.location__text= `- ${li.text}`
			img.location__img(src="img/location-img.webp", alt="location-img")

		.location__map#map
