section.faq#faq 
	.container 
		.faq__title 
			+title('часто задаваемые', 'вопросы')
		.faq__box 
			each item in faqs
				.faq__item
					.faq-header.js-faq-toggle 
						span.faq-header__text= item.title
						i.fas.fa-chevron-down
					.faq-body 
						p.faq-body__text= item.text